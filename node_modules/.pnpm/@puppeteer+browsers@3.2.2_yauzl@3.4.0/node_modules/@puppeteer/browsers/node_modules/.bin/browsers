#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/rool-drive/projects/dice-roller/node_modules/.pnpm/@puppeteer+browsers@3.2.2_yauzl@3.4.0/node_modules/@puppeteer/browsers/node_modules:/rool-drive/projects/dice-roller/node_modules/.pnpm/@puppeteer+browsers@3.2.2_yauzl@3.4.0/node_modules:/rool-drive/projects/dice-roller/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/rool-drive/projects/dice-roller/node_modules/.pnpm/@puppeteer+browsers@3.2.2_yauzl@3.4.0/node_modules/@puppeteer/browsers/node_modules:/rool-drive/projects/dice-roller/node_modules/.pnpm/@puppeteer+browsers@3.2.2_yauzl@3.4.0/node_modules:/rool-drive/projects/dice-roller/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../../lib/main-cli.js" "$@"
else
  exec node  "$basedir/../../lib/main-cli.js" "$@"
fi
